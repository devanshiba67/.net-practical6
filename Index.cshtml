
@model List<WebApplication14.Models.Product>

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>ProductHub | Catalog</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f4f6f9;
            color: #1f2937;
        }

        /* Navigation */

        .navbar {
            background: #172554;
            color: white;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .logo span {
            color: #60a5fa;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links a {
            color: #dbeafe;
            text-decoration: none;
            font-size: 14px;
        }

        .nav-links a:hover {
            color: white;
        }

        /* Hero */

        .hero {
            background: linear-gradient(135deg, #1e3a8a, #2563eb);
            color: white;
            padding: 55px 8%;
        }

        .hero h1 {
            font-size: 38px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .hero p {
            font-size: 16px;
            color: #dbeafe;
            max-width: 550px;
            line-height: 1.7;
        }

        /* Main */

        .container {
            width: 84%;
            max-width: 1200px;
            margin: 45px auto;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .section-header h2 {
            font-size: 27px;
            color: #111827;
        }

        .section-header p {
            color: #64748b;
            margin-top: 7px;
            font-size: 14px;
        }

        .product-count {
            background: #dbeafe;
            color: #1d4ed8;
            padding: 10px 18px;
            border-radius: 25px;
            font-size: 13px;
            font-weight: 600;
        }

        /* Product Grid */

        .product-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .product-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 26px;
            box-shadow: 0 4px 15px rgba(15, 23, 42, 0.04);
            transition: 0.3s;
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.10);
        }

        .card-top {
            height: 5px;
            width: 45px;
            background: #2563eb;
            border-radius: 10px;
            margin-bottom: 24px;
        }

        .category {
            color: #2563eb;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .product-name {
            font-size: 21px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 10px;
        }

        .product-id {
            font-size: 13px;
            color: #94a3b8;
            margin-bottom: 25px;
        }

        .divider {
            height: 1px;
            background: #e5e7eb;
            margin-bottom: 20px;
        }

        .product-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .price-label {
            color: #94a3b8;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 5px;
        }

        .price {
            font-size: 22px;
            font-weight: 700;
            color: #111827;
        }

        .btn {
            background: #2563eb;
            color: white;
            padding: 10px 16px;
            border: none;
            border-radius: 7px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
        }

        .btn:hover {
            background: #1d4ed8;
        }

        /* Footer */

        .footer {
            background: #172554;
            color: #94a3b8;
            text-align: center;
            padding: 28px;
            margin-top: 65px;
            font-size: 13px;
        }

        /* Responsive */

        @@media (max-width: 900px) {

            .product-grid {
                grid-template-columns: repeat(2, 1fr);
            }

        }

        @@media (max-width: 600px) {

            .navbar {
                flex-direction: column;
                gap: 15px;
            }

            .hero h1 {
                font-size: 30px;
            }

            .product-grid {
                grid-template-columns: 1fr;
            }

            .container {
                width: 90%;
            }

            .section-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .product-bottom {
                flex-wrap: wrap;
            }

        }

    </style>

</head>

<body>

    <!-- Navigation -->

    <nav class="navbar">

        <div class="logo">
            Product<span>Hub</span>
        </div>

        <ul class="nav-links">

            <li>
                <a href="@Url.Action("Index", "Product")">
                    Home
                </a>
            </li>

            <li>
                <a href="#products">
                    Products
                </a>
            </li>

            <li>
                <a href="#about">
                    About
                </a>
            </li>

        </ul>

    </nav>


    <!-- Hero Section -->

    <section class="hero">

        <h1>Product Catalog</h1>

        <p>
            Explore our collection of quality products
            with transparent pricing and detailed information.
        </p>

    </section>


    <!-- Products -->

    <main class="container" id="products">

        <div class="section-header">

            <div>

                <h2>Our Products</h2>

                <p>
                    Browse our available product collection
                </p>

            </div>

            <div class="product-count">

                @Model.Count Products

            </div>

        </div>


        <div class="product-grid">

            @foreach (var product in Model)
            {

                <div class="product-card">

                    <div class="card-top"></div>

                    <div class="category">
                        @product.Category
                    </div>

                    <div class="product-name">
                        @product.Name
                    </div>

                    <div class="product-id">
                        PRODUCT ID: #@product.Id
                    </div>

                    <div class="divider"></div>

                    <div class="product-bottom">

                        <div>

                            <div class="price-label">
                                Product Price
                            </div>

                            <div class="price">
                                ₹@product.Price.ToString("N0")
                            </div>

                        </div>

                        <a href="@Url.Action("Details", "Product", new { id = product.Id })"
                           class="btn">
                            Details
                        </a>

                    </div>

                </div>

            }

        </div>

    </main>


    <!-- Footer -->

    <footer class="footer" id="about">

        <p>
            © @DateTime.Now.Year ProductHub.
            All Rights Reserved.
        </p>

        <p style="margin-top: 8px;">
            ASP.NET MVC | Product Catalog Application
        </p>

    </footer>

</body>
</html>
